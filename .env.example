# Copy to .env (scripts/setup.ps1 or scripts/setup.sh do it for you).
# Passwords are NOT here: they live in ./secrets/*.txt (Docker secrets).

# --- symbolic names of the database containers (Lab 5) ---
EVENTS_DB_CONTAINER=pos-mariadb
CLIENTS_DB_CONTAINER=pos-mongo
IDM_DB_CONTAINER=pos-idm-db

# --- Event WebService (MariaDB) ---
DB_NAME=events
DB_USER=events_app
DB_ADMIN_USER=events_admin

# --- Client WebService (MongoDB) ---
MONGO_ADMIN_USER=mongo_admin
MONGO_DB_NAME=clients
MONGO_DB_OWNER_USER=clients_owner
MONGO_APP_USER=clients_app
MONGO_CLIENTS_COLLECTION=clients

# --- IDM (gRPC + MariaDB) ---
IDM_DB_NAME=idm
IDM_DB_USER=idm_app
IDM_JWT_SECRET=change-me-to-a-long-random-string
IDM_JWT_ISSUER=https://pos-idm-service:50051

# --- public URLs used in HATEOAS links between services ---
EVENTS_PUBLIC_URL=http://localhost:8000
CLIENTS_PUBLIC_URL=http://localhost:8001
